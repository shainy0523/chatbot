# ---- required ----
# Create a key at https://aistudio.google.com/apikey (no quotes, no spaces)
GEMINI_API_KEY=

# ---- optional ----
# Better web/news search (https://tavily.com). Wikipedia is used when unset.
TAVILY_API_KEY=

PORT=5001
NODE_ENV=development
LOG_LEVEL=info

# Deployed web app URL(s) allowed to call this API, comma-separated.
# (http://localhost:5173 and :8081 are always allowed for development.)
CORS_ORIGINS=

# Set to 1 when running behind one reverse proxy (Render, Railway, Fly, nginx)
# so rate limiting sees real client IPs instead of the proxy's.
TRUST_PROXY=

# ---- tuning (defaults shown) ----
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_TIMEOUT_MS=25000
# MAX_MESSAGE_CHARS=2000
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_SUGGESTIONS_PER_MIN=10
# RATE_LIMIT_API_PER_MIN=120
